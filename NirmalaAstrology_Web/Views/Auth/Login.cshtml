@model NirmalaAstrology_Web.ViewModels.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Admin Login";
}

<section class="py-5" style="margin-top:80px;">
    <div class="container" style="max-width:480px;">
        <div class="glass-card p-4">
            <h1 class="h3 text-gold mb-2">Sign in</h1>
            <p class="text-light-muted small mb-4">Admin workspace or registered customer account.</p>
            @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                <div class="mb-3">
                    <label class="form-label text-light">Username</label>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control glass-input", autocomplete = "username" })
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Password</label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control glass-input", autocomplete = "current-password" })
                </div>
                <div class="form-check mb-3 text-light">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                    <label class="form-check-label" for="RememberMe">Remember me</label>
                </div>
                <button type="submit" class="btn btn-gold w-100">Sign in</button>
            }
            <p class="text-light-muted small mt-3 mb-1"><a href="@Url.Action("Register", "Account")">Create account</a> · <a href="@Url.Action("ForgotPassword", "Account")">Forgot password</a></p>
            <p class="text-light-muted small mb-0">Guests can browse Home, Zodiac, Contact, Payment, Reports, and limited Kundli without login.</p>
        </div>
    </div>
</section>
