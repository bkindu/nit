<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nirmala Astrology - A Group of Scholars since 1974. Generate your Kundli, daily horoscope, match making, numerology, and more." />
    <meta name="keywords" content="Astrology, Kundli, Horoscope, Match Making, Numerology, Palm Reading, Vedic Astrology" />
    <meta name="author" content="Nirmala Astrology" />
    <title>@ViewBag.Title - Nirmala Astrology</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Free icons (self-hosted — avoids CDN / encoding garbage glyphs) -->
    <link href="~/Content/vendor/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- AOS Animate on Scroll -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="~/Content/css/site.css?v=1.5" rel="stylesheet" />
    <link href="~/Content/css/letterhead-print.css?v=1.0" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/Images/logo.png" />

    <style>
        /* Loader Styles */
        #preloader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #0a0a1a; z-index: 99999;
            display: flex; align-items: center; justify-content: center; flex-direction: column;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }
        #preloader.hidden { opacity: 0; visibility: hidden; }
        .loader-zodiac {
            width: 80px; height: 80px; border: 4px solid transparent;
            border-top-color: #FFD700; border-right-color: #B22222;
            border-radius: 50%; animation: spin 1.2s linear infinite;
        }
        .loader-zodiac::before {
            content: ''; position: absolute; top: 8px; left: 8px; right: 8px; bottom: 8px;
            border: 4px solid transparent; border-bottom-color: #FFD700; border-left-color: #B22222;
            border-radius: 50%; animation: spin 0.8s linear reverse infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .loader-text { color: #FFD700; margin-top: 16px; font-family: 'Poppins', sans-serif; font-size: 14px; letter-spacing: 2px; }
    </style>
</head>
<body class="letterhead-export">
    <!-- Preloader -->
    <div id="preloader">
        <div class="loader-zodiac" style="position:relative;"></div>
        <p class="loader-text">NIRMALA ASTROLOGY</p>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNavbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/Images/logo.png" alt="Nirmala Astrology" class="brand-logo me-2" />
                <div class="brand-text">
                    <span class="brand-name">Nirmala Astrology</span>
                    <span class="brand-tagline">A Group of Scholars | Estd. 1974</span>
                </div>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link active" href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Services</a>
                        <ul class="dropdown-menu" aria-labelledby="servicesDropdown">
                            @if (User != null && User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                            <li><a class="dropdown-item" href="@Url.Action("Index", "BirthData")">Birth Data / Kundli</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "MatchMaking")">Match Making</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Records")">Search Records</a></li>
                            }
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Numerology")">Numerology</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "PublicReport")">Reports &amp; Pricing</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Appointment")">Book Appointment</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#kundli-section">Quick Kundli</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Zodiac")">Zodiac Signs</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "PublicReport")">Reports</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Appointment")">Book</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Contact")">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Payment")">Payment</a></li>
                    @if (User != null && User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Admin"))
                        {
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Admin</a></li>
                        }
                        else
                        {
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Account")">My Account</a></li>
                        }
                    <li class="nav-item">
                        @using (Html.BeginForm("Logout", "Auth", FormMethod.Post, new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link nav-link">Logout</button>
                        }
                    </li>
                    }
                    else
                    {
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Auth")">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">Register</a></li>
                    }
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-gold btn-sm px-3" href="@Url.Action("Index", "Home")#kundli-section">Generate Kundli</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Add Place Modal -->
    <div class="modal fade" id="addPlaceModal" tabindex="-1" aria-labelledby="addPlaceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-card">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title text-gold" id="addPlaceModalLabel">
                        <i class="fas fa-map-marker-alt me-2"></i>Add New Place
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("AddPlace", "Home", FormMethod.Post, new { id = "addPlaceForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-light">Place Name <span class="text-danger">*</span></label>
                                <input type="text" name="PlaceName" class="form-control glass-input" required placeholder="e.g., New Delhi" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light">Country <span class="text-danger">*</span></label>
                                <select name="CountryID" class="form-select glass-input" required id="countrySelect">
                                    <option value="">-- Select Country --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-light">Latitude <span class="text-danger">*</span></label>
                                <input type="number" step="any" name="Latitude" class="form-control glass-input" required placeholder="e.g., 28.6139" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-light">Longitude <span class="text-danger">*</span></label>
                                <input type="number" step="any" name="Longitude" class="form-control glass-input" required placeholder="e.g., 77.2090" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-light">TimeZone <span class="text-danger">*</span></label>
                                <input type="text" name="TimeZone" class="form-control glass-input" required placeholder="e.g., 5.5" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-light">SMTCorr</label>
                                <select name="SMTCorr" class="form-select glass-input">
                                    <option value="">-- None --</option>
                                    <option value="E">E (East)</option>
                                    <option value="W">W (West)</option>
                                </select>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-gold" id="savePlaceBtn">
                        <i class="fas fa-save me-1"></i> Save Place
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-stars"></div>
        <div class="container">
            <div class="row g-4 py-5">
                <!-- Brand Column -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand">
                        <img src="~/Images/logo.png" alt="Nirmala Astrology" class="footer-logo mb-3" />
                        <h4 class="text-gold mb-2">Nirmala Astrology</h4>
                        <p class="text-light-muted">A Group of Scholars established in 1974, providing authentic Vedic astrology guidance for over 50 years. Trust, accuracy, and tradition define our services.</p>
                        <div class="social-links mt-3">
                            <a href="#" class="social-icon" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-icon" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social-icon" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                            <a href="#" class="social-icon" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                            <a href="#" class="social-icon" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        </div>
                    </div>
                </div>
                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li><a href="@Url.Action("Index", "Zodiac")">Zodiac Signs</a></li>
                        <li><a href="#">About Us</a></li>
                        <li><a href="@Url.Action("Index", "Contact")">Contact Us</a></li>
                        <li><a href="@Url.Action("Index", "Payment")">Payment / UPI</a></li>
                        <li><a href="@Url.Action("Login", "Auth")">Admin Login</a></li>
                        <li><a href="@Url.Action("Index", "Articles")">Articles</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms & Conditions</a></li>
                    </ul>
                </div>
                <!-- Services -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Our Services</h5>
                    <ul class="footer-links">
                        <li><a href="@Url.Action("Index", "BirthData")">Generate Kundli</a></li>
                        <li><a href="@Url.Action("Index", "MatchMaking")">Match Making</a></li>
                        <li><a href="@Url.Action("Index", "Numerology")">Numerology</a></li>
                        <li><a href="@Url.Action("Index", "Palmistry")">Palm Reading</a></li>
                        <li><a href="#">Daily Horoscope</a></li>
                        <li><a href="#">Yearly Horoscope</a></li>
                        <li><a href="#">Vastu Consultation</a></li>
                    </ul>
                </div>
                <!-- Contact Info -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Contact Us</h5>
                    <ul class="footer-contact">
                        <li><i class="fas fa-map-marker-alt"></i> <span>Sidhu Colony, Behind Central Jail, Bhadson Road, Patiala-147005 (Pb.) &middot; also 410, Sector 114, White City, Mohali</span></li>
                        <li><i class="fas fa-phone-alt"></i> <span><a href="tel:+919855110123" class="text-light-muted text-decoration-none">98551-10123</a> (Pre-appointment only)</span></li>
                        <li><i class="fas fa-envelope"></i> <span><a href="mailto:nirmala.astrology@gmail.com" class="text-light-muted text-decoration-none">nirmala.astrology@gmail.com</a></span></li>
                        <li><i class="fas fa-globe"></i> <span><a href="https://www.nirmalaastrology.com" class="text-light-muted text-decoration-none" target="_blank" rel="noopener">www.nirmalaastrology.com</a></span></li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="footer-bottom text-center py-3">
                <p class="mb-0 text-light-muted">&copy; @DateTime.Now.Year Nirmala Astrology. All Rights Reserved. | A Group of Scholars - Estd. 1974</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="~/Scripts/Custom/site.js?v=1.4"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>