<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Nirmala Astrology</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/vendor/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/css/site.css?v=1.5" rel="stylesheet" />
    <link href="~/Content/css/letterhead-print.css?v=1.0" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Images/logo.png" />
</head>
<body class="app-shell letterhead-export">
    @{
        var controller = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
        var action = (ViewContext.RouteData.Values["action"] ?? "").ToString();
        // Explicit empty area: when rendering inside Admin Area, Url.Action otherwise inherits area="Admin"
        // and wrongly generates /Admin/Home, /Admin/BirthData, etc.
        object root = new { area = "" };
    }
    <header class="app-header">
        <button type="button" class="app-menu-btn" id="appSidebarToggle" aria-label="Open navigation">
            <i class="fas fa-bars"></i>
        </button>
        <a class="app-brand" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
            <img src="~/Images/logo.png" alt="Nirmala Astrology" />
            <span>
                <strong>Nirmala Astrology</strong>
                <small>Admin Workspace</small>
            </span>
        </a>
        @if (User != null && User.Identity != null && User.Identity.IsAuthenticated)
        {
            <span class="text-light small d-none d-md-inline ms-2">@User.Identity.Name</span>
            using (Html.BeginForm("Logout", "Auth", new { area = "" }, FormMethod.Post, new { @class = "d-inline ms-2" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-gold">Logout</button>
            }
        }
        else
        {
            <a class="btn btn-outline-gold btn-sm ms-2" href="@Url.Action("Login", "Auth", root)">Admin login</a>
        }
    </header>
    <div class="app-body">
        <aside class="app-sidebar" id="appSidebar">
            <nav>
                <a class="@(controller == "BirthData" ? "active" : "")" href="@Url.Action("Index", "BirthData", root)"><i class="fas fa-id-card"></i> Birth Data</a>
                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"><i class="fas fa-tachometer-alt"></i> Admin Home</a>
                <a class="@(controller == "Kundli" || controller == "Home" && (ViewContext.RouteData.Values["action"] ?? "").ToString() == "KundliResult" ? "active" : "")" href="@Url.Action("KundliResult", "Home", root)"><i class="fas fa-dharmachakra"></i> Kundli</a>
                <a class="@(controller == "Home" && action == "KundliResult" ? "active" : "")" href="@Url.Action("KundliResult", "Home", root)"><i class="fas fa-file-pdf"></i> Official Report</a>
                <a class="@(controller == "MatchMaking" ? "active" : "")" href="@Url.Action("Index", "MatchMaking", root)"><i class="fas fa-heart"></i> Match Making</a>
                <a class="@(controller == "Numerology" ? "active" : "")" href="@Url.Action("Index", "Numerology", root)"><i class="fas fa-hashtag"></i> Numerology</a>
                <a class="@(controller == "Records" ? "active" : "")" href="@Url.Action("Index", "Records", root)"><i class="fas fa-database"></i> Records</a>
                <a href="@Url.Action("Index", "Appointments", new { area = "Admin" })"><i class="fas fa-calendar-check"></i> Appointments</a>
                <a href="@Url.Action("Index", "Articles", new { area = "Admin" })"><i class="fas fa-newspaper"></i> Articles</a>
                <a href="#" data-bs-toggle="modal" data-bs-target="#addPlaceModal"><i class="fas fa-map-marker-alt"></i> Places</a>
                <a class="@(controller == "Muhurat" ? "active" : "")" href="@Url.Action("Index", "Muhurat", root)"><i class="fas fa-calendar-alt"></i> Muhurat</a>
                <a class="@(controller == "VivahMuhurta" ? "active" : "")" href="@Url.Action("Index", "VivahMuhurta", root)"><i class="fas fa-ring"></i> Vivah Muhurta</a>
                <a class="@(controller == "Gochar" ? "active" : "")" href="@Url.Action("Index", "Gochar", root)"><i class="fas fa-globe"></i> Gochar</a>
                <a class="@(controller == "VarshPhal" ? "active" : "")" href="@Url.Action("Index", "VarshPhal", root)"><i class="fas fa-sun"></i> Varsh Phal</a>
                <a class="@(controller == "LalKitab" ? "active" : "")" href="@Url.Action("Index", "LalKitab", root)"><i class="fas fa-book"></i> Lal Kitab</a>
                <a class="@(controller == "Palmistry" ? "active" : "")" href="@Url.Action("Index", "Palmistry", root)"><i class="fas fa-hand-paper"></i> Palmistry</a>
            </nav>
        </aside>
        <div class="app-main">
            <div class="app-breadcrumb no-print">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Admin Home</a>
                <span>/</span>
                <span>@ViewBag.Title</span>
            </div>
            @if (ViewBag.HidePdfBar as bool? != true)
            {
            <div class="letterhead-export-bar no-print">
                <a class="btn btn-sm btn-gold js-pdf-download" href="@Url.Action("KundliPdf", "Report", root)" data-no-spinner="1"><i class="fas fa-file-pdf me-1"></i>Export PDF</a>
            </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            <main class="app-content">
                @RenderBody()
            </main>
            <footer class="app-footer no-print">Nirmala Astrology &middot; Sidhu Colony, Bhadson Road, Patiala &middot; 98551-10123 &middot; nirmala.astrology@gmail.com</footer>
        </div>
    </div>
    <div class="modal fade" id="addPlaceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-card">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title text-gold">Add New Place</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("AddPlace", "Home", new { area = "" }, FormMethod.Post, new { id = "addPlaceForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label text-light">Place Name</label><input type="text" name="PlaceName" class="form-control glass-input" required /></div>
                            <div class="col-md-6"><label class="form-label text-light">Country</label><select name="CountryID" class="form-select glass-input" id="countrySelect"><option value="">-- Select --</option></select></div>
                            <div class="col-md-3"><label class="form-label text-light">Latitude</label><input type="number" step="any" name="Latitude" class="form-control glass-input" required /></div>
                            <div class="col-md-3"><label class="form-label text-light">Longitude</label><input type="number" step="any" name="Longitude" class="form-control glass-input" required /></div>
                            <div class="col-md-3"><label class="form-label text-light">TimeZone</label><input type="text" name="TimeZone" class="form-control glass-input" required placeholder="5.5" /></div>
                            <div class="col-md-3"><label class="form-label text-light">SMTCorr</label><select name="SMTCorr" class="form-select glass-input"><option value="">None</option><option value="E">E</option><option value="W">W</option></select></div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-gold" id="savePlaceBtn">Save Place</button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Custom/site.js?v=1.4"></script>
    <script>
        (function () {
            var btn = document.getElementById('appSidebarToggle');
            var side = document.getElementById('appSidebar');
            if (btn && side) btn.addEventListener('click', function () { side.classList.toggle('open'); });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
