@model NirmalaAstrology_Web.Models.AppointmentRecord
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Appointment Details";
    var pay = ViewBag.Payment as NirmalaAstrology_Web.Models.PaymentRecord;
}
<section class="py-5" style="margin-top:80px;">
    <div class="container" style="max-width:720px;">
        <div class="glass-card p-4">
            <h1 class="h3 text-gold">Appointment</h1>
            <table class="table table-dark table-sm">
                <tr><th>Booking ref</th><td>@Model.BookingRef</td></tr>
                <tr><th>Service</th><td>@Model.ServiceName</td></tr>
                <tr><th>When</th><td>@Model.AppointmentDate.ToString("dd/MM/yyyy") · @NirmalaAstrology_Web.Services.AppointmentService.FormatTime(Model.AppointmentTime)</td></tr>
                <tr><th>Amount</th><td>₹@Model.Amount.ToString("0.00") @Model.Currency</td></tr>
                <tr><th>Payment status</th><td>@Model.PaymentStatus</td></tr>
                <tr><th>Appointment status</th><td>@Model.AppointmentStatus</td></tr>
                @if (pay != null)
                {
                    <tr><th>Order id</th><td>@pay.OrderId</td></tr>
                    <tr><th>Txn ref</th><td>@(pay.TransactionRef ?? "—")</td></tr>
                }
            </table>
            @if (Model.AppointmentStatus == NirmalaAstrology_Web.Models.AppointmentStatuses.PendingPayment)
            {
                <a class="btn btn-gold" href="@Url.Action("Pay", new { id = Model.AppointmentId })">Pay now</a>
            }
            <a class="btn btn-outline-gold" href="@Url.Action("Index", "Account")">My account</a>
        </div>
    </div>
</section>
