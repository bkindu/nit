@model NirmalaAstrology_Web.ViewModels.VarshPhalViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = "Varsh Phal";
}

<div class="page-header">
    <h1>Varsh Phal</h1>
    <p>MVP from VB6 <code>qVarshPhal</code>: Varsh Parvesh, Muntha, Mudda dasha, and core Sahams. Birth data comes from session.</p>
</div>

@if (!Model.HasBirthSession)
{
    <div class="alert alert-warning">Save a chart in <a href="@Url.Action("Index", "BirthData")">Birth Data</a> first.</div>
}
else
{
    <p class="text-light-muted">@Model.BirthSummary</p>
    using (Html.BeginForm("Index", "VarshPhal", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
        <div class="glass-card p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-light">Target year</label>
                    @Html.TextBoxFor(m => m.TargetYear, new { @class = "form-control glass-input", type = "number", min = "1900", max = "2100" })
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-gold">Calculate Varsh Phal</button>
                </div>
            </div>
        </div>
    }
}

@if (Model.Result != null)
{
    var r = Model.Result;
    <section class="glass-card p-4 mt-4">
        <h2 class="h4 text-gold">@r.NativeName · age year @r.AgeYearLabel (@r.TargetYear)</h2>
        <p class="text-light-muted mb-1">Completed years at Jan 1: @r.CompletedYears</p>
        <p class="mb-1">Varsh Parvesh: <strong>@r.ParveshDateText @r.ParveshTimeText</strong></p>
        <p class="mb-1">Birth Lagna @r.BirthLagnaSignName · Varsh Lagna @r.VarshLagnaSignName</p>
        <p class="mb-1">Birth Nak @r.BirthNakshatra · Varsh Nak @r.VarshNakshatra</p>
        <p>Muntha: <strong>@r.MunthaSignName</strong> (@r.MunthaSign)</p>

        <h3 class="h6 text-gold mt-3">Varsh graha spasta</h3>
        <div class="table-responsive">
            <table class="table table-dark table-sm app-table">
                <thead><tr><th>Point</th><th>Sign</th><th>House</th><th>Longitude</th></tr></thead>
                <tbody>
                @foreach (var p in r.VarshPlanets)
                {
                    <tr><td>@p.Name</td><td>@p.SignName</td><td>@p.House</td><td>@p.Longitude.ToString("0.0000")</td></tr>
                }
                </tbody>
            </table>
        </div>

        <h3 class="h6 text-gold mt-3">Mudda dasha</h3>
        <div class="table-responsive">
            <table class="table table-dark table-sm app-table">
                <thead><tr><th>Lord</th><th>Ends</th></tr></thead>
                <tbody>
                @foreach (var m in r.Mudda)
                {
                    <tr><td>@m.Lord</td><td>@m.EndDate</td></tr>
                }
                </tbody>
            </table>
        </div>

        <h3 class="h6 text-gold mt-3">Sahams</h3>
        <div class="table-responsive">
            <table class="table table-dark table-sm app-table">
                <thead><tr><th>Saham</th><th>RAKV</th><th>Longitude</th></tr></thead>
                <tbody>
                @foreach (var s in r.Sahams)
                {
                    <tr><td>@s.Name</td><td>@s.Rakv</td><td>@s.Longitude.ToString("0.0000")</td></tr>
                }
                </tbody>
            </table>
        </div>

        <ul class="mt-3 mb-0 small text-light-muted">
            @foreach (var n in r.Notes)
            {
                <li>@n</li>
            }
        </ul>
    </section>
}
