@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contact-section py-5" style="margin-top: 80px;">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="section-title text-gold mb-2">Contact Us</h2>
            <p class="text-light-muted">Details from Nirmala Astrology visiting card · Pre-appointment only</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5" data-aos="fade-right">
                <div class="glass-card p-4 h-100">
                    <h4 class="text-gold mb-4"><i class="fas fa-headset me-2"></i>Reach Us Directly</h4>

                    <div class="contact-person mb-4 p-3" style="border-left: 3px solid var(--gold); background: rgba(178,34,34,0.08);">
                        <h5 class="text-light mb-1" style="font-size: 1.1rem;">Indu Sharma</h5>
                        <p class="text-gold mb-1" style="font-size: 0.9rem;">Astrologer · Motivational Astro-Guide/Counselor</p>
                        <p class="text-light-muted mb-0" style="font-size: 0.85rem;">Nirmala Astrology — A Group of Scholars · Estd. 1974</p>
                    </div>

                    <div class="contact-detail-item d-flex align-items-start mb-4">
                        <div class="contact-icon-wrap me-3"><i class="fas fa-phone-alt"></i></div>
                        <div>
                            <h6 class="text-light mb-1">Phone</h6>
                            <a href="tel:+919855110123" class="text-light-muted contact-link">98551-10123</a>
                            <div class="text-danger small mt-1">Pre-appointment only</div>
                        </div>
                    </div>

                    <div class="contact-detail-item d-flex align-items-start mb-4">
                        <div class="contact-icon-wrap me-3"><i class="fas fa-envelope"></i></div>
                        <div>
                            <h6 class="text-light mb-1">Email</h6>
                            <a href="mailto:nirmala.astrology@gmail.com" class="text-light-muted contact-link">nirmala.astrology&#64;gmail.com</a>
                        </div>
                    </div>

                    <div class="contact-detail-item d-flex align-items-start mb-4">
                        <div class="contact-icon-wrap me-3"><i class="fas fa-globe"></i></div>
                        <div>
                            <h6 class="text-light mb-1">Website</h6>
                            <a href="https://www.nirmalaastrology.com" class="text-light-muted contact-link" target="_blank" rel="noopener">www.nirmalaastrology.com</a>
                        </div>
                    </div>

                    <div class="contact-detail-item d-flex align-items-start mb-4">
                        <div class="contact-icon-wrap me-3"><i class="fas fa-map-marker-alt"></i></div>
                        <div>
                            <h6 class="text-light mb-1">Addresses</h6>
                            <p class="text-light-muted mb-2">Sidhu Colony, Behind Central Jail, Bhadson Road, Patiala-147005 (Pb.)</p>
                            <p class="text-light-muted mb-0">410, Sector 114, White City, Mohali</p>
                        </div>
                    </div>

                    <div class="contact-detail-item d-flex align-items-start mb-4">
                        <div class="contact-icon-wrap me-3"><i class="fas fa-users"></i></div>
                        <div>
                            <h6 class="text-light mb-1">Team</h6>
                            <p class="text-light-muted mb-1 small">Mangat Ram — Computer Programmer, P.Secretary (Retd.)</p>
                            <p class="text-light-muted mb-1 small">Nirmal Jit Kaur — Computerised / handwritten janampatri specialist</p>
                            <p class="text-light-muted mb-0 small">Jasdeep Singh — Engineer, Graduate</p>
                        </div>
                    </div>

                    <div class="mt-3 p-3" style="background: rgba(255,215,0,0.06); border-radius: 8px;">
                        <p class="text-light-muted mb-2" style="font-size: 0.85rem; font-style: italic;">
                            Using self-coded Astrological software &amp; self written books
                        </p>
                        <a href="@Url.Action("Index", "Payment")" class="btn btn-sm btn-gold">
                            <i class="fas fa-qrcode me-1"></i>Payment / UPI
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-7" data-aos="fade-left">
                <div class="glass-card p-4">
                    <h4 class="text-gold mb-4"><i class="fas fa-paper-plane me-2"></i>Send Us a Message</h4>
                    @using (Html.BeginForm("SendEmail", "Contact", FormMethod.Post, new { id = "contactForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-light">Your Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" id="contactName" class="form-control glass-input" required placeholder="Enter your name" maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light">Your Email <span class="text-danger">*</span></label>
                                <input type="email" name="email" id="contactEmail" class="form-control glass-input" required placeholder="Enter your email" maxlength="150" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-light">Subject <span class="text-danger">*</span></label>
                                <input type="text" name="subject" id="contactSubject" class="form-control glass-input" required placeholder="e.g., Kundli Consultation" maxlength="200" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-light">Message <span class="text-danger">*</span></label>
                                <textarea name="message" id="contactMessage" class="form-control glass-input" rows="5" required placeholder="Write your message here..." maxlength="2000" style="resize: vertical; min-height: 120px;"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="button" id="sendEmailBtn" class="btn btn-gold btn-lg w-100">
                                    <i class="fas fa-paper-plane me-2"></i>Send Message
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function ($) {
            $('#sendEmailBtn').on('click', function () {
                var name = $('#contactName').val().trim();
                var email = $('#contactEmail').val().trim();
                var subject = $('#contactSubject').val().trim();
                var message = $('#contactMessage').val().trim();

                if (!name || !email || !subject || !message) {
                    if (typeof showToast === 'function') showToast('All fields are required.', 'error');
                    return;
                }

                var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRegex.test(email)) {
                    if (typeof showToast === 'function') showToast('Please enter a valid email address.', 'error');
                    return;
                }

                if (typeof showSpinner === 'function') showSpinner();

                $.ajax({
                    url: '/Contact/SendEmail',
                    type: 'POST',
                    data: {
                        name: name,
                        email: email,
                        subject: subject,
                        message: message,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    success: function (response) {
                        if (typeof hideSpinner === 'function') hideSpinner();
                        if (response.success) {
                            if (typeof showToast === 'function') showToast(response.message, 'success');
                            $('#contactForm')[0].reset();
                        } else {
                            if (typeof showToast === 'function') showToast(response.message, 'error');
                        }
                    },
                    error: function () {
                        if (typeof hideSpinner === 'function') hideSpinner();
                        if (typeof showToast === 'function') showToast('Error sending message. Please try again.', 'error');
                    }
                });
            });
        })(jQuery);
    </script>
}
