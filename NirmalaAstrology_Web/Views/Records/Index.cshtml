@model IList<NirmalaAstrology_Web.Models.NativeRecordModel>
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = "Search Records";
    var request = ViewBag.Request as NirmalaAstrology_Web.Models.NativeSearchRequest ?? new NirmalaAstrology_Web.Models.NativeSearchRequest();
    var total = ViewBag.TotalCount as int? ?? 0;
    var pages = ViewBag.PageCount as int? ?? 1;
}

<div class="page-header">
    <h1>Search Records</h1>
    <p>VB6 Record search: locate a stored native and send the birth data back to the entry sheet.</p>
</div>

<form method="get" class="glass-card p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Name</label><input class="form-control glass-input" name="Name" value="@request.Name" /></div>
        <div class="col-md-3"><label class="form-label">Place</label><input class="form-control glass-input" name="Place" value="@request.Place" /></div>
        <div class="col-md-2"><label class="form-label">Date</label><input class="form-control glass-input" name="BirthDate" value="@request.BirthDate" placeholder="dd.MM.yyyy" /></div>
        <div class="col-md-2"><label class="form-label">Address</label><input class="form-control glass-input" name="Address" value="@request.Address" /></div>
        <div class="col-md-2"><label class="form-label">Sr. No.</label><input class="form-control glass-input" name="SerialNo" value="@request.SerialNo" /></div>
    </div>
    <div class="mt-3">
        <button class="btn btn-gold" type="submit">Search</button>
        <a class="btn btn-outline-light" href="@Url.Action("Index")">Clear</a>
    </div>
</form>

<div class="glass-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 app-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>G</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Place</th>
                    <th>Address</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-light-muted py-4">No records found. Run 04_tbl_native.sql and migrate Access Record_F_Natives.</td></tr>
                }
                else
                {
                    foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.NativeId</td>
                            <td>@row.NativeName</td>
                            <td>@row.Gender</td>
                            <td>@(row.BirthDateText ?? (row.BirthDate.HasValue ? row.BirthDate.Value.ToString("dd.MM.yyyy") : ""))</td>
                            <td>@(row.BirthTimeText ?? (row.BirthTime.HasValue ? row.BirthTime.Value.ToString(@"hh\:mm") : ""))</td>
                            <td>@row.BirthPlace</td>
                            <td>@row.AddressText</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-gold" href="@Url.Action("Index", "BirthData", new { id = row.NativeId })">Load</a>
                                @using (Html.BeginForm("Delete", "Records", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete this native record?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.NativeId" />
                                    <button class="btn btn-sm btn-outline-light" type="submit">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-light-muted mt-3 small">@total record(s). Page @request.Page of @pages.</p>
@if (pages > 1)
{
    <nav class="mt-2">
        @for (var p = 1; p <= pages && p <= 20; p++)
        {
            <a class="btn btn-sm @(p == request.Page ? "btn-gold" : "btn-outline-light")" href="@Url.Action("Index", new { request.Name, request.Place, request.BirthDate, request.Address, request.SerialNo, Page = p })">@p</a>
        }
    </nav>
}
