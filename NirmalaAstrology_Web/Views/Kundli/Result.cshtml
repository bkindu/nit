@section Scripts {
    <script src="~/Scripts/custom/kundli-chart-svg.js?v=3.1"></script>
    <script>
        var DASHA_ABBR = {
            Ketu: 'Ket', Sukra: 'Suk', Surya: 'Sur', Chandra: 'Cha', Mangla: 'Man', Mangal: 'Man',
            Rahu: 'Rah', Guru: 'Gur', Sani: 'San', Budha: 'Bud'
        };
        function dashaAbbr(name) {
            if (!name) return '---';
            var k = String(name).trim();
            return DASHA_ABBR[k] || (k.length <= 3 ? k : k.substring(0, 3));
        }
        function renderVb6VimshottariDasha(dasha) {
            var host = document.getElementById('vimshottariDashaPrint');
            if (!host || !dasha) return;
            var mahas = dasha.mahaDashas || [];
            var antars = dasha.antarDashas || [];
            var birth = dasha.birthDateLabel || '';
            var html = '';
            for (var g = 0; g < 3; g++) {
                html += '<div class="vb6-dasha-group">';
                for (var c = 0; c < 3; c++) {
                    var m = mahas[g * 3 + c];
                    if (!m) { html += '<div class="vb6-dasha-col"></div>'; continue; }
                    var list = antars.filter(function (a) { return Number(a.mahaSequence) === Number(m.sequence); });
                    var pad = Math.max(0, 9 - list.length);
                    html += '<div class="vb6-dasha-col">';
                    html += '<div class="md-title">Maha Dasa of ' + (m.lord || '') + ' (' + (m.years || '') + 'y)</div>';
                    html += '<div class="md-period">' + (m.fromDate || '') + ' to ' + (m.toDate || '') + '</div>';
                    html += '<div class="md-age">' + (m.ageLabel || '') + '</div>';
                    html += '<div class="md-head"><span>Antar</span><span>Beginning &nbsp; Enging</span></div>';
                    for (var i = 0; i < 9; i++) {
                        if (i < pad) {
                            html += '<div class="md-row"><span>-</span><span>***********</span><span class="pipe">|</span></div>';
                        } else {
                            var a = list[i - pad];
                            var label = dashaAbbr(a.mahaLord) + '-' + dashaAbbr(a.antarLord);
                            var from = a.fromDate || birth;
                            var range = from + '-' + (a.toDate || '');
                            html += '<div class="md-row"><span>' + label + '</span><span>' + range + '</span><span class="pipe">|</span></div>';
                        }
                    }
                    html += '</div>';
                }
                html += '</div>';
            }
            host.innerHTML = html;
        }
        function renderExtraDashaVb6(block) {
            var periods = block.periods || [];
            if (!periods.length) return '<p class="text-light-muted small">No periods.</p>';
            // Group consecutive same mahaLord into columns of up to 3
            var byMaha = [];
            var map = {};
            periods.forEach(function (p) {
                var key = p.mahaLord || '-';
                if (!map[key]) { map[key] = []; byMaha.push(key); }
                map[key].push(p);
            });
            var html = '';
            for (var i = 0; i < byMaha.length; i += 3) {
                html += '<div class="vb6-dasha-group">';
                for (var c = 0; c < 3; c++) {
                    var lord = byMaha[i + c];
                    if (!lord) { html += '<div class="vb6-dasha-col"></div>'; continue; }
                    var rows = map[lord];
                    var from = rows[0].fromDate || '';
                    var to = rows[rows.length - 1].toDate || '';
                    html += '<div class="vb6-dasha-col">';
                    html += '<div class="md-title">Maha Dasa of ' + lord + '</div>';
                    html += '<div class="md-period">' + from + ' to ' + to + '</div>';
                    html += '<div class="md-head"><span>Antar</span><span>Beginning &nbsp; Enging</span></div>';
                    rows.slice(0, 12).forEach(function (p) {
                        var label = dashaAbbr(p.mahaLord) + '-' + dashaAbbr(p.antarLord || p.mahaLord);
                        html += '<div class="md-row"><span>' + label + '</span><span>' + (p.fromDate || '') + '-' + (p.toDate || '') + '</span><span class="pipe">|</span></div>';
                    });
                    html += '</div>';
                }
                html += '</div>';
            }
            return html;
        }

        $(document).ready(function () {
            // Official PDF uses ReportController (link above). Do not print the on-screen form.

            var birthData = @Html.Raw(String.IsNullOrWhiteSpace(Model.BirthDataJson) ? "null" : Model.BirthDataJson);
            if (!birthData || !birthData.year) {
                birthData = JSON.parse(localStorage.getItem('kundliBirthData') || 'null');
            }

            if (!birthData || !birthData.year) {
                $('#kundliPersonInfo').html('<span class="text-danger">No birth data found. Please go back and enter details.</span>');
                return;
            }

            var day = birthData.day;
            var month = birthData.month;
            var year = birthData.year;
            var hours = birthData.hours;
            var minutes = birthData.minutes;
            var longitude = birthData.longitude;
            var latitude = birthData.latitude;
            var timezone = birthData.timezone == null ? 5.5 : birthData.timezone;
            var name = birthData.name;
            var place = birthData.place;

            $('#kundliPersonInfo').html('<span class="text-info"><i class="fas fa-spinner fa-spin me-2"></i>Calculating your Kundli...</span>');

            $.ajax({
                url: '/Home/CalculateKundli',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    day: day,
                    month: month,
                    year: year,
                    hours: hours,
                    minutes: minutes,
                    latitude: latitude,
                    longitude: longitude,
                    timezone: timezone
                },
                dataType: 'json',
                success: function (response) {
                    if (!response.success || !response.result) {
                        $('#kundliPersonInfo').html('<span class="text-danger">Calculation failed: ' + (response.message || 'Unknown error') + '</span>');
                        console.error('Calculation error:', response);
                        return;
                    }

                    var result = response.result;
                    $('#pdfExportWrapper').show();
                    if (window.prefetchPdf) window.prefetchPdf($('#btnExportA4Pdf').attr('href'));

                    // Populate the single Otp_Detaile report header.
                    var gender = birthData.gender || 'Male';
                    var pad2 = function (n) { return String(n).padStart(2, '0'); };
                    var dobText = pad2(day) + '.' + pad2(month) + '.' + year;
                    var timeText = pad2(hours) + '.' + pad2(minutes) + ' ' + (hours < 12 ? 'AM' : 'PM');
                    $('#otpReportName').text(name || 'NATIVE');
                    $('#otpGender').text(gender);
                    $('#otpRelation').text(gender === 'Female' ? 'D/o' : 'S/o');
                    $('#otpDob').text(dobText);
                    $('#otpTime').text(timeText);
                    $('#otpDay').text(['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'][new Date(year, month - 1, day).getDay()]);
                    $('#otpPlace').text(place || '-');
                    $('#otpLongitude').text(Number(longitude).toFixed(2) + (Number(longitude) < 0 ? ' WEST' : ' EAST'));
                    $('#otpLatitude').text(Number(latitude).toFixed(2) + (Number(latitude) < 0 ? ' SOUTH' : ' NORTH'));
                    $('#otpVikrami').text(year + 57);
                    $('#otpSaka').text(year - 79);
                    // VB6: Format_RAK(FNDM(dAyanamsa)) / Format_RAK(FNDM(ST/15)) — never plain decimals
                    $('#otpAyanamsa').text(result.ayanamsaRak || '-');
                    $('#otpSidereal').text(result.siderealTimeRak || '-');
                    $('#otpGmt').text((String(Math.abs(Number(timezone) || 0)).padStart(2, '0') + ':00'));
                    $('#otpDetaileReport').show();
                    $('#kundliPersonInfo').html('<strong class="text-light">' + name + '</strong><br>' +
                        '<span class="text-light-muted">DOB: ' + day + '/' + month + '/' + year + ' | Time: ' + hours + ':' + String(minutes).padStart(2, '0') +
                        ' | Place: ' + place + '</span>');

                    

                    // Generate SVG chart
                    try {
                        if (typeof generateKundliSVG === 'function' && result.houses) {
                            generateKundliSVG(result.houses, {
                                templateUrl: '@Url.Content("~/Content/Kun.svg")',
                                planetPositions: result.planetPositions || []
                            }).then(function (chartSVG) {
                                $('#kundliChart').html('<div class="ni-chart-svg">' + chartSVG + '</div>');
                                $('#chartContainer').show();

                                // Setup PNG download using the bound SVG template
                                setupPNGDownload(chartSVG);
                                $('#pngDownloadWrapper').show();
                            }).catch(function (e) {
                                console.error('SVG template binding error:', e);
                                $('#kundliPersonInfo').append('<br><small class="text-danger">Chart binding error: ' + e.message + '</small>');
                            });
                        } else {
                            console.error('generateKundliSVG not found or no houses data');
                            $('#kundliPersonInfo').append('<br><small class="text-warning">Chart generation: SVG function not available</small>');
                        }
                    } catch (e) {
                        console.error('SVG generation error:', e);
                        $('#kundliPersonInfo').append('<br><small class="text-danger">Chart generation error: ' + e.message + '</small>');
                    }

                    // Bind the first-page VB6-style Nirayana Graha Spasta rows.
                    var reportRows = '';
                    var reportPlanets = (result.details && result.details.planets) || [];
                    reportPlanets.forEach(function (planet) {
                        // Legacy VB6 RAKV is 0-based rashi (09:25:39:00), built server-side from longitude.
                        var position = planet.positionRakv || '-';
                        reportRows += '<tr><td>' + (planet.fullName || planet.name || '-') + '</td><td>' + (planet.code || '-') + ' ' + position + '</td><td>' + (planet.gati || '-') + '</td><td>' + (planet.motion || '-') + '</td><td>' + (planet.udayAsta || '-') + '</td><td>' + (planet.nakshatraNumber || '-') + '/' + (planet.nakshatraPada || '-') + '</td><td>' + (planet.nakshatraLord || '-') + ' / ' + (planet.nakshatraDevta || '-') + '</td><td>' + (planet.dignity || '-') + '</td></tr>';
                    });
                    $('#otpPlanetTable tbody').html(reportRows || '<tr><td colspan="8">No planet details available.</td></tr>');
                    if (result.details) {
                        var panchang = result.details.panchang || {};
                        $('#otpSamvatsar').text(panchang.samvatsar || '-');
                        $('#otpVikrami').text(panchang.vikramiSamvat || '-');
                        $('#otpSaka').text(panchang.sakaSamvat || '-');
                        $('#otpAyan').text(panchang.ayan || '-');
                        $('#otpGola').text(panchang.gola || '-');
                        $('#otpRitu').text(panchang.ritu || '-');
                        $('#otpSaurMaas').text(panchang.saurMaas || '-');
                        $('#otpPaksha').text(panchang.paksha || '-');
                        $('#otpNakshatra, #otpCurrentNakshatra').text(panchang.sunriseNakshatra || panchang.nakshatra || result.details.nakshatraName || '-');
                        $('#otpCharan').text(panchang.nakshatraPada || result.details.nakshatraPada || '-');
                        $('#otpTithi').text(panchang.sunriseTithi || panchang.tithi || '-');
                        $('#otpCurrentTithi').text(panchang.tithi || '-');
                        $('#otpYoga').text(panchang.sunriseYoga || panchang.yoga || '-');
                        $('#otpCurrentYoga').text(panchang.yoga || '-');
                        $('#otpKaran').text(panchang.sunriseKaran || panchang.karan || '-');
                        $('#otpCurrentKaran').text(panchang.karan || '-');
                        $('#otpVaar').text(panchang.vaarHindu || panchang.vaarEnglish || '-');
                        $('#otpSunrise').text(panchang.sunrise || '-');
                        $('#otpSunset').text(panchang.sunset || '-');
                        $('#otpIshtakal').text(panchang.ishtakal || '-');
                        $('#otpDinman').text(panchang.dinman || '-');
                        $('#otpTithiEnding').text(panchang.tithiEnding || '-'); $('#otpVaarEnding').text(panchang.vaarEnding || '-');
                        $('#otpKaranEnding').text(panchang.karanEnding || '-'); $('#otpYogaEnding').text(panchang.yogaEnding || '-');
                        $('#otpNakshatraEnding').text(panchang.nakshatraEnding || '-');
                        $('#otpTithiBhukat').text(panchang.tithiBhukat || '-');
                        $('#otpTithiBhogya').text(panchang.tithiBhogya || '-');
                        // VB6 Prn_HoroPanchang repeats the Tithi GP values on the Vaar row.
                        $('#otpVaarBhukat').text(panchang.tithiBhukat || '-');
                        $('#otpVaarBhogya').text(panchang.tithiBhogya || '-');
                        $('#otpYogaBhukat').text(panchang.yogaBhukat || '-');
                        $('#otpYogaBhogya').text(panchang.yogaBhogya || '-');
                        $('#otpKaranBhukat').text(panchang.karanBhukat || '-');
                        $('#otpKaranBhogya').text(panchang.karanBhogya || '-');
                        $('#otpBhabhog').text(panchang.bhabhog || '48000 Vikala');
                        $('#otpGmt').text(panchang.gmt || '-');
                        $('#otpApparentNoon').text(panchang.apparentNoon || '-');
                        $('#otpLocalMeanTime').text(panchang.localMeanTime || '-');
                        $('#otpDeclination').text(panchang.declinationOfSun || '-');
                        $('#otpSidereal').text(panchang.siderealTime || '-');
                        $('#otpAyanamsa').text(panchang.ayanamsa || '-');
                        $('#otpVelantar').text(panchang.velantar || '-');
                        $('#otpCharaPal').text(panchang.charaPal || '-');
                        $('#otpPalbha').text(panchang.palbha || '-');
                        $('#otpMeanSun').text(panchang.meanSun || '-');
                        $('#otpWarTime').text(panchang.warTimeCorrection || '-');
