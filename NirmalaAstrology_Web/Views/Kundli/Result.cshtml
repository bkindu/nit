            // SVG to PNG download function
            function setupPNGDownload(svgString) {
                $('#btnDownloadPNG').on('click', function () {
                    try {
                        // Extract SVG content
                        var svgEl = document.querySelector('#kundliChart svg');
                        if (!svgEl) {
                            alert('Chart not found');
                            return;
                        }

                        // Clone and ensure proper namespace
                        var clonedSvg = svgEl.cloneNode(true);
                        clonedSvg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');

                        var svgData = new XMLSerializer().serializeToString(clonedSvg);
                        var svgBlob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
                        var svgUrl = URL.createObjectURL(svgBlob);

                        // Create canvas and draw
                        var canvas = document.createElement('canvas');
                        canvas.width = 840;  // 2x for higher resolution
                        canvas.height = 840;
                        var ctx = canvas.getContext('2d');

                        var img = new Image();
                        img.onload = function () {
                            ctx.fillStyle = '#FFFEF5';
                            ctx.fillRect(0, 0, canvas.width, canvas.height);
                            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                            URL.revokeObjectURL(svgUrl);

                            // Download PNG
                            var pngUrl = canvas.toDataURL('image/png');
                            var link = document.createElement('a');
                            link.download = 'kundli-chart.png';
                            link.href = pngUrl;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        };
                        img.onerror = function () {
                            URL.revokeObjectURL(svgUrl);
                            // Fallback: download SVG instead
                            var link = document.createElement('a');
                            link.download = 'kundli-chart.svg';
                            link.href = svgUrl;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                            alert('PNG conversion failed. SVG file downloaded instead.');
                        };
                        img.src = svgUrl;
                    } catch (e) {
                        console.error('PNG download error:', e);
                        alert('Error generating PNG: ' + e.message);
                    }
                });
            }
        });
       </script>
}
