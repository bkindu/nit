@model dynamic
@{
    ViewBag.Title = "Kundli Result - Nirmala Astrology";
    // Admin workspace uses _AppLayout (admin-only nav). Public visitors keep site chrome.
    var isAdmin = User != null && User.Identity != null && User.Identity.IsAuthenticated
        && User.IsInRole(NirmalaAstrology_Web.Services.AuthService.RoleAdmin);
    Layout = isAdmin ? "~/Views/Shared/_AppLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";
    ViewBag.HidePdfBar = true;
}
<div class="container py-5">
    <div class="row justify-content-center" data-aos="fade-up">
        <div class="col-lg-10">
            <div class="glass-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-sun-fill fa-2x text-gold mb-2" style="font-size:2rem;"></i>
                    <h2 class="text-gold">Your Kundli</h2>
                    <p class="text-light-muted" id="kundliPersonInfo">Loading...</p>
                </div>

                <!-- Otp_Detaile / Prn_HoroPanchang first page -->
                <section id="otpDetaileReport" class="otp-report mb-4" style="display:none;">
                    <h4 class="text-gold text-center">HOROSCOPE</h4>
                    <h5 class="text-gold text-center" id="otpReportName">NATIVE</h5>
                    <div class="otp-line"><span>Gender</span><strong id="otpGender">Male</strong><span id="otpRelation">S/o</span></div>

                    <h5 class="text-gold">BIRTH DATA</h5>
                    <table class="table table-dark table-bordered table-sm"><tbody>
                        <tr><th>DATE OF BIRTH</th><td id="otpDob">-</td><th>BIRTH TIME</th><td id="otpTime">-</td></tr>
                        <tr><th>DAY (Eng)</th><td id="otpDay">-</td><th>BIRTH PLACE</th><td id="otpPlace">-</td></tr>
                        <tr><th>LONGITUDE</th><td id="otpLongitude">-</td><th>LATITUDE</th><td id="otpLatitude">-</td></tr>
                    </tbody></table>

                    <h5 class="text-gold">CALENDARICAL TERMS (NORTH INDIAN)</h5>
                    <table class="table table-dark table-bordered table-sm"><tbody>
                        <tr><th>SAMVATSAR</th><td id="otpSamvatsar">-</td><th>VIKRAMI SAMVAT</th><td id="otpVikrami">-</td></tr>
                        <tr><th>SAKA SAMVAT</th><td id="otpSaka">-</td><th>AYAN</th><td id="otpAyan">-</td></tr>
                        <tr><th>GOLA</th><td id="otpGola">-</td><th>RITU</th><td id="otpRitu">-</td></tr>
                        <tr><th>SAUR MAAS</th><td id="otpSaurMaas">-</td><th>PAKSHA</th><td id="otpPaksha">-</td></tr>
                    </tbody></table>

                    <h5 class="text-gold">SURYODYA KAALIK PANCHANG</h5>
                    <table class="table table-dark table-bordered table-sm"><tbody>
                        <tr><th>TITHI</th><td id="otpTithi">-</td><th>SUN RISE</th><td id="otpSunrise">-</td></tr>
                        <tr><th>NAKSHATRA</th><td id="otpNakshatra">-</td><th>SUN SET</th><td id="otpSunset">-</td></tr>
                        <tr><th>YOGA</th><td id="otpYoga">-</td><th>ISHATKAL</th><td id="otpIshtakal">-</td></tr>
                        <tr><th>KARAN</th><td id="otpKaran">-</td><th>DINMAN</th><td id="otpDinman">-</td></tr>
                    </tbody></table>
                    <table class="table table-dark table-bordered table-sm" id="otpEndingTable"><tbody>
                        <tr><th>TITHI ENDING</th><td id="otpTithiEnding">-</td><th>VAAR</th><td id="otpVaarEnding">-</td></tr>
                        <tr><th>KARAN ENDING</th><td id="otpKaranEnding">-</td><th>YOGA ENDING</th><td id="otpYogaEnding">-</td></tr>
                        <tr><th>NAKSHATRA ENDING</th><td id="otpNakshatraEnding">-</td><th></th><td></td></tr>
                    </tbody></table>

                    <h5 class="text-gold">TAATKALIK PANCHANG (CURRENT)</h5>
                    <table class="table table-dark table-bordered table-sm"><tbody>
                        <tr><th>TITHI</th><td id="otpCurrentTithi">-</td><th>Bhukat</th><td id="otpTithiBhukat">-</td><th>Bhogya</th><td id="otpTithiBhogya">-</td></tr>
                        <tr><th>VAAR (Hindu)</th><td id="otpVaar">-</td><th>Bhukat</th><td id="otpVaarBhukat">-</td><th>Bhogya</th><td id="otpVaarBhogya">-</td></tr>
                        <tr><th>YOGA</th><td id="otpCurrentYoga">-</td><th>Bhukat</th><td id="otpYogaBhukat">-</td><th>Bhogya</th><td id="otpYogaBhogya">-</td></tr>
                        <tr><th>KARAN</th><td id="otpCurrentKaran">-</td><th>Bhukat</th><td id="otpKaranBhukat">-</td><th>Bhogya</th><td id="otpKaranBhogya">-</td></tr>
                        <tr><th>NAKSHATRA</th><td id="otpCurrentNakshatra">-</td><th>CHARAN</th><td id="otpCharan">-</td><th>BHABHOG</th><td id="otpBhabhog">48000 Vikala</td></tr>
                    </tbody></table>

                    <h5 class="text-gold">HORA CHAKRAM</h5>
                    <table class="table table-dark table-bordered table-sm" id="otpHoraTable"><tbody>
                        <tr><th>RASHI</th><td id="horaRashi">-</td><th>RASHIPATI</th><td id="horaRashiLord">-</td></tr>
                        <tr><th>VARAN</th><td id="horaVaran">-</td><th>VASHYA</th><td id="horaVashya">-</td></tr>
                        <tr><th>HANSAK</th><td id="horaHansak">-</td><th>RASHI NAME</th><td id="horaRashiName">-</td></tr>
                        <tr><th>YONI</th><td id="horaYoni">-</td><th>GANA</th><td id="horaGana">-</td></tr>
                        <tr><th>NADI</th><td id="horaNadi">-</td><th>YUNJA</th><td id="horaYunja">-</td></tr>
                        <tr><th>NAME LETTER</th><td id="horaNameLetter">-</td><th>VARAG</th><td id="horaVarag">-</td></tr>
                        <tr><th>PAYA</th><td id="horaPaya">-</td><th>SUN SIGN</th><td id="horaSunSign">-</td></tr>
                    </tbody></table>

                    <h5 class="text-gold">GHAT CHAKRAM</h5>
                    <table class="table table-dark table-bordered table-sm" id="otpGhatTable"><tbody>
                        <tr><th>MAAS</th><td id="ghatMaas">-</td><th>TITHIES</th><td id="ghatTithies">-</td></tr>
                        <tr><th>VAAR</th><td id="ghatVaar">-</td><th>NAKSHATAR</th><td id="ghatNakshatra">-</td></tr>
                        <tr><th>YOG</th><td id="ghatYog">-</td><th>KARAN</th><td id="ghatKaran">-</td></tr>
                        <tr><th>PRAHAR</th><td id="ghatPrahar">-</td><th>LAGAN</th><td id="ghatLagan">-</td></tr>
                        <tr><th>PLANETS</th><td colspan="3" id="ghatPlanetPositions">-</td></tr>
                        <tr><th>GRAH</th><td id="ghatGrah">-</td><th>DHANYA</th><td id="ghatDhanya">-</td></tr>
                        <tr><th>JATI</th><td id="ghatJati">-</td><th>GENDER</th><td id="ghatGender">-</td></tr>
                        <tr><th>KARURADI</th><td id="ghatKaruradi">-</td><th>CHARADI</th><td id="ghatCharadi">-</td></tr>
                        <tr><th>VARNA</th><td id="ghatVarna">-</td><th></th><td></td></tr>
                    </tbody></table>

                    <h5 class="text-gold">MISCELLANEOUS DATA</h5>
                    <table class="table table-dark table-bordered table-sm"><tbody>
                        <tr><th>APPARENT NOON</th><td id="otpApparentNoon">-</td><th>G.M.T.</th><td id="otpGmt">-</td></tr>
                        <tr><th>LOCAL MEAN TIME</th><td id="otpLocalMeanTime">-</td><th>DECLINATION OF SUN</th><td id="otpDeclination">-</td></tr>
                        <tr><th>SIDEREAL TIME</th><td id="otpSidereal">-</td><th>AYANAMSA</th><td id="otpAyanamsa">-</td></tr>
                        <tr><th>VELANTAR</th><td id="otpVelantar">-</td><th>CHARA PAL</th><td id="otpCharaPal">-</td></tr>
                        <tr><th>PALBHA</th><td id="otpPalbha">-</td><th>MEAN SUN</th><td id="otpMeanSun">-</td></tr>
                        <tr><th>WAR TIME CORR.</th><td id="otpWarTime">-</td><th>TRUE RAHU</th><td id="otpTrueRahu">-</td></tr>
                    </tbody></table>

                    <h5 class="text-gold">NIRAYANA GRAHA SPASTA</h5>
                    <div class="table-responsive"><table class="table table-dark table-bordered table-sm" id="otpPlanetTable"><thead><tr>
                        <th>Name</th>
                        <th>Graha&nbsp;&nbsp;s&nbsp;º&nbsp;'&nbsp;"</th>
                        <th>Gati</th>
                        <th>Margi/Vakri</th>
                        <th>Udya/Astha</th>
                        <th>Nak/Pad</th>
                        <th>Nak.-Swami Grh Devta</th>
                        <th>Ucha-adi</th>
                    </tr></thead><tbody></tbody></table></div>
                </section>

                <!-- SVG Chart -->
                <div class="text-center mb-4" id="chartContainer" style="display:none;">
                    <h5 class="text-gold mb-3" style="font-family:Consolas, 'Courier New', monospace;">JANAM LAGAN KUNDALI</h5>
                    <div class="kundli-chart-shell p-3" style="background:#FFFEF5;border-radius:8px;border:2px solid #D2691E;width:100%;max-width:520px;margin:0 auto;">
                        <div id="kundliChart" class="kundli-chart-host"></div>
                    </div>
                </div>

                <!-- PNG Download -->
                <div class="text-center mb-4" id="pngDownloadWrapper" style="display:none;">
                    <button id="btnDownloadPNG" class="btn btn-sm" style="background:#D2691E;color:#fff;border:none;">
                        <i class="fas fa-download me-2"></i>Download Kundli as PNG
                    </button>
                </div>

                <!-- Download from this result — no preview page, no second calculation. -->
                <div class="text-center mb-4 no-print" id="pdfExportWrapper" style="display:none;">
                    @if (isAdmin)
                    {
                        <a id="btnExportA4Pdf" class="btn btn-sm btn-gold js-pdf-download"
                           href="@Url.Action("KundliPdf", "Report")" data-no-spinner="1">
                            <i class="fas fa-file-pdf me-2"></i>Export PDF
                        </a>
                    }
                    else
                    {
                        <a id="btnExportA4Pdf" class="btn btn-sm btn-gold js-pdf-download"
                           href="@Url.Action("DownloadBasicKundli", "PublicReport")" data-no-spinner="1">
                            <i class="fas fa-file-pdf me-2"></i>Export PDF
                        </a>
                    }
                    <div class="small text-light-muted mt-2" id="pdfExportStatus">Preparing the report from this kundli…</div>
                </div>

                <!-- Detailed Horoscope Page 2: planetary details -->
                <section id="kundliDetailsSection" style="display:none;" class="mt-4 detailed-page-two">
                    <div class="report-page-title">DETAILED HOROSCOPE — PLANETARY DETAILS <span>Page No. : 2</span></div>
                    <h4 class="text-gold mb-3">Kundli Details</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4"><div class="detail-card"><small>Birth Rashi</small><strong id="detailBirthRashi">-</strong></div></div>
                        <div class="col-md-4"><div class="detail-card"><small>Sun Sign</small><strong id="detailSunSign">-</strong></div></div>
                        <div class="col-md-4"><div class="detail-card"><small>Janma Nakshatra</small><strong id="detailNakshatra">-</strong></div></div>
                        <div class="col-md-4"><div class="detail-card"><small>Gandmool</small><strong id="detailGandmool">-</strong></div></div>
                        <div class="col-md-4"><div class="detail-card"><small>Paya (Rashi / Nakshatra)</small><strong id="detailPaya">-</strong></div></div>
                        <div class="col-md-4"><div class="detail-card"><small>Manglik Yoga</small><strong id="detailManglik">-</strong></div></div>
                    </div>

                    <div id="retroInfo" style="display:none;" class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Retrograde planets:</strong> <span id="retroText">-</span>
                    </div>

                    <h5 class="text-gold">House &amp; Planet Strength (graph)</h5>
                    <p class="text-light-muted small" id="percentageNote"></p>
                    <div class="row g-3 mb-3" id="percentGraphPage">
                        <div class="col-lg-7">
                            <h6 class="text-gold">Bhava / House %</h6>
                            <div id="housePercentGraph"></div>
                        </div>
                        <div class="col-lg-5">
                            <h6 class="text-gold">Graha %</h6>
                            <div id="planetPercentGraph"></div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-bordered table-sm" id="housePercentageTable">
                            <thead><tr><th>House</th><th>Rashi</th><th>Planets</th><th>Calculated %</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <section id="ganitChainSection" style="display:none;" class="mt-4 detailed-page-two">
                        <div class="report-page-title">GRAHA BALA, SPECIAL LAGNAS, YOGAS <span>DETAILED / MEDIUM</span></div>

                        <h5 class="text-gold">Shadbala (Graha Bala)</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="grahaBalaTable">
                                <thead><tr><th>Planet</th><th>Sthana</th><th>Dig</th><th>Kala</th><th>Cheshta</th><th>Naisarga</th><th>Drishti</th><th>Total</th><th>Rupa</th><th>Req</th><th>%</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Bhava Bala</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="bhavaBalaTable">
                                <thead><tr><th>House</th><th>Dig</th><th>Lord Shadbala</th><th>Total</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <h5 class="text-gold">Special Lagnas</h5>
                                <div class="table-responsive"><table class="table table-dark table-bordered table-sm" id="specialLagnaTable"><thead><tr><th>Lagna</th><th>Sign</th><th>RAKV</th></tr></thead><tbody></tbody></table></div>
                            </div>
                            <div class="col-md-6">
                                <h5 class="text-gold">Dhoomadi Upagrahas</h5>
                                <div class="table-responsive"><table class="table table-dark table-bordered table-sm" id="upgrahaTable"><thead><tr><th>Point</th><th>Sign</th><th>RAKV</th></tr></thead><tbody></tbody></table></div>
                            </div>
                        </div>
                        <h5 class="text-gold">Special Lagna Kundlis</h5>
                        <div class="row g-3 mb-4" id="specialLagnaCharts"></div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <h5 class="text-gold">Gulikadi (Mantreshwar)</h5>
                                <div class="table-responsive"><table class="table table-dark table-bordered table-sm" id="mantreshwarUpgrahaTable"><thead><tr><th>Point</th><th>Sign</th><th>RAKV</th></tr></thead><tbody></tbody></table></div>
                            </div>
                            <div class="col-md-6">
                                <h5 class="text-gold">Gulikadi (Brihat Parasari)</h5>
                                <div class="table-responsive"><table class="table table-dark table-bordered table-sm" id="parasaraUpgrahaTable"><thead><tr><th>Point</th><th>Sign</th><th>RAKV</th></tr></thead><tbody></tbody></table></div>
                            </div>
                        </div>

                        <h5 class="text-gold">Graha Avasthas</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="avasthaTable">
                                <thead><tr><th>Planet</th><th>Baladi</th><th>Jagradadi</th><th>Deeptadi</th><th>Charadi</th><th>Arohi</th><th>Pravas</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Kinshukadi Sangya</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="kinshukTable">
                                <thead><tr><th>Planet</th><th>Shodasha</th><th>Dasa</th><th>Sapta</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Panchadha Maitri</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="panchadhaTable">
                                <thead><tr><th>Planet</th><th>Sun</th><th>Moon</th><th>Mars</th><th>Merc</th><th>Jup</th><th>Ven</th><th>Sat</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Detected Yogas</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="yogaTable">
                                <thead><tr><th>Yoga</th><th>Category</th><th>Note</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <div id="extraDashaBlock" style="display:none;">
                            <h5 class="text-gold">DETAILED dashas (eDashasAll)</h5>
                            <p class="text-light-muted small mb-2">Krittikadi/Ardradi Ashtottari, Yogini, Shodshottari, Panchottari, Shatabadika, Chaturshityabadika, Davisapatika, Sashathihayani, Sandhya, Pachak.</p>
                            <div id="extraDashaSystems"></div>
                        </div>
                    </section>

                    <section id="ashtakavargaSection" style="display:none;" class="mt-4 detailed-page-two">
                        <div class="report-page-title">ASHTAKAVARGA <span>DETAILED / MEDIUM</span></div>
                        <p class="text-light-muted small mb-2">Non-Parasara school with North-Indian Trikona sodhan (VB6 <code>lAstakVarg</code> defaults).</p>

                        <h5 class="text-gold">Sarvashtakavarga (Mesh → Meen)</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="sarvaAstakTable">
                                <thead><tr><th>Type</th><th>Mes</th><th>Vrs</th><th>Mit</th><th>Krk</th><th>Sim</th><th>Kan</th><th>Tul</th><th>Vrk</th><th>Dhn</th><th>Mkr</th><th>Kum</th><th>Min</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Individual Ashtak Vargas</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="individualAstakTable">
                                <thead><tr><th>Planet</th><th>Total</th><th>Mes</th><th>Vrs</th><th>Mit</th><th>Krk</th><th>Sim</th><th>Kan</th><th>Tul</th><th>Vrk</th><th>Dhn</th><th>Mkr</th><th>Kum</th><th>Min</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Pinda Sodhan</h5>
                        <div class="table-responsive">
                            <table class="table table-dark table-bordered table-sm" id="pindaAstakTable">
                                <thead><tr><th>Planet</th><th>Rasi Pinda</th><th>Graha Pinda</th><th>Total</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </section>

                    <section id="varga16Section" style="display:none;" class="mt-4 detailed-page-two">
                        <div class="report-page-title">SHODASHA VARGA TABLE (16 DIVISIONS) <span>DETAILED / MEDIUM</span></div>
                        <p class="text-light-muted small mb-2">Sign numbers (1–12) for Lagna and nine planets in each varga. Port of VB6 <code>FnShodashVargCalc</code>.</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-dark table-bordered table-sm" id="varga16Table">
                                <thead>
                                    <tr>
                                        <th>Varga</th><th>Code</th>
                                        <th>Lag</th><th>Sun</th><th>Mon</th><th>Mar</th><th>Mer</th>
                                        <th>Jup</th><th>Ven</th><th>Sat</th><th>Rah</th><th>Ket</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <h5 class="text-gold">Shodasha Varga Kundlis (D-1 … D-60)</h5>
                        <p class="text-light-muted small mb-2">North Indian charts for all 16 divisions (VB6 <code>Varg16KundaliesCalcAndPrinting</code>).</p>
                        <div class="row g-3 mb-3" id="vargaAllCharts"></div>
                        <h5 class="text-gold">Varga deities (D-2 … D-30)</h5>
                        <div class="table-responsive mb-4">
                            <table class="table table-dark table-bordered table-sm" id="vargaDeityTable">
                                <thead><tr><th>Varga</th><th>Planet</th><th>Deity / Lord</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </section>

                    <section id="bhavaDashaSection" style="display:none;" class="mt-4 detailed-page-two">
                        <div class="report-page-title">BHAVA SPASTA &amp; VIMSHOTTARI DASHA <span>DETAILED / MEDIUM</span></div>

                        <h5 class="text-gold">Bhava Spasta (Neelkhanth)</h5>
                        <p class="text-light-muted small mb-2">House madhya and sandhi from Lagna and Dasham (MC).</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-dark table-bordered table-sm" id="bhavaSpastaTable">
                                <thead><tr><th>House</th><th>Bhava Madhya (R:A:K:V)</th><th>Bhava Sandhi (R:A:K:V)</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <h5 class="text-gold">Chalit Chakra — planet houses</h5>
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered table-sm" id="chalitPlanetTable">
                                <thead><tr><th>Planet</th><th>Rashi House</th><th>Chalit House</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <h5 class="text-gold">Chalit Chakra Kundli</h5>
                        <div class="row justify-content-center mb-4">
                            <div class="col-md-6" id="chalitChartHost"></div>
                        </div>

                        <h5 class="text-gold">Vimshottari Dasha</h5>
                        <p class="text-light-muted small" id="dashaBalanceText">-</p>
                        <p class="text-light-muted small mb-2">Dates given below show ending moments of Dasa in AD Era.</p>
                        <div id="vimshottariDashaPrint" class="vb6-dasha-print mb-3"></div>
                        <details class="mb-3">
                            <summary class="text-gold small" style="cursor:pointer;">Show flat Maha / Antar tables</summary>
                            <div class="table-responsive mb-3 mt-2">
                                <table class="table table-dark table-bordered table-sm" id="mahaDashaTable">
                                    <thead><tr><th>#</th><th>Maha Dasa</th><th>Years</th><th>From</th><th>To</th><th>Age</th></tr></thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-dark table-bordered table-sm" id="antarDashaTable">
