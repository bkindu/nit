@model NirmalaAstrology_Web.ViewModels.LalKitabViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = "Lal Kitab";
}

<div class="page-header">
    <h1>Lal Kitab</h1>
    <p>MVP from VB6 <code>rLalKitab</code>: Janam houses, age-year Varsh remap via <code>Lal_Kitab_Digits</code>, and remedies for Janam or Varsh mode.</p>
</div>

@if (!Model.HasBirthSession)
{
    <div class="alert alert-warning">Save a chart in <a href="@Url.Action("Index", "BirthData")">Birth Data</a> first.</div>
}
else
{
    <p class="text-light-muted">@Model.BirthSummary</p>
    using (Html.BeginForm("Index", "LalKitab", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
        <div class="glass-card p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-light">Age year (1–110)</label>
                    @Html.TextBoxFor(m => m.AgeYear, new { @class = "form-control glass-input", type = "number", min = "1", max = "110" })
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light">Remedy mode</label>
                    <div class="d-flex gap-3 text-light">
                        <label class="form-check-label">@Html.RadioButtonFor(m => m.RemedyMode, "Janam") Janam</label>
                        <label class="form-check-label">@Html.RadioButtonFor(m => m.RemedyMode, "Varsh") Varsh</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-gold">Calculate Lal Kitab</button>
                </div>
            </div>
        </div>
    }
}

@if (Model.Result != null)
{
    var r = Model.Result;
    <section class="glass-card p-4 mt-4">
        <h2 class="h4 text-gold">@r.NativeName · age @r.AgeYear · @r.RemedyMode remedies</h2>
        <p class="text-light-muted mb-1">@r.BirthSummary</p>
        <p>Lagna: <strong>@r.LagnaSignName</strong> (@r.LagnaSign)</p>

        <h3 class="h6 text-gold mt-3">House remap (birth house → Varsh house)</h3>
        <div class="table-responsive">
            <table class="table table-dark table-sm app-table">
                <thead><tr>@for (var h = 1; h <= 12; h++) { <th>H@h</th> }</tr></thead>
                <tbody>
                    <tr>@for (var h = 1; h <= 12; h++) { <td>@r.HouseRemap[h]</td> }</tr>
                </tbody>
            </table>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <h3 class="h6 text-gold">Janam Kundli</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-sm app-table">
                        <thead><tr><th>Planet</th><th>Sign</th><th>House</th></tr></thead>
                        <tbody>
                        @foreach (var p in r.JanamPlanets)
                        {
                            <tr><td>@p.Planet</td><td>@p.SignName</td><td>@p.House</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-6">
                <h3 class="h6 text-gold">Varsh Kundli (digit remap)</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-sm app-table">
                        <thead><tr><th>Planet</th><th>Sign</th><th>House</th></tr></thead>
                        <tbody>
                        @foreach (var p in r.VarshPlanets)
                        {
                            <tr><td>@p.Planet</td><td>@p.SignName</td><td>@p.House</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <h3 class="h6 text-gold mt-3">Remedies (@r.RemedyMode)</h3>
        @foreach (var rem in r.Remedies)
        {
            <div class="mb-3">
                <h4 class="h6 mb-1">@rem.Planet (@rem.Key)</h4>
                <p class="mb-0 small" style="white-space:pre-wrap;">@rem.Reading</p>
            </div>
        }

        <ul class="mt-3 mb-0 small text-light-muted">
            @foreach (var n in r.Notes)
            {
                <li>@n</li>
            }
        </ul>
    </section>
}
