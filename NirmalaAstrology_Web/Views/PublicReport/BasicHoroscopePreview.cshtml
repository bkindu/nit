@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Report Preview";
    var pdf = ViewBag.PdfBase64 as string;
    var file = ViewBag.FileName as string ?? "report.pdf";
}
<section class="py-5" style="margin-top:80px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 text-gold mb-0">Single-page report preview</h1>
            <div>
                <a class="btn btn-sm btn-gold" href="data:application/pdf;base64,@pdf" download="@file">Download PDF</a>
                <button type="button" class="btn btn-sm btn-outline-gold" onclick="window.frames['pdfFrame'].print()">Print</button>
            </div>
        </div>
        <iframe id="pdfFrame" name="pdfFrame" title="PDF" style="width:100%;height:80vh;border:1px solid #444;background:#fff;"
                src="data:application/pdf;base64,@pdf"></iframe>
    </div>
</section>
