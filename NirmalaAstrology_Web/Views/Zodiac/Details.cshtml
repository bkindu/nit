@model NirmalaAstrology_Web.Models.ZodiacDbModel
@{
    ViewBag.Title = Model.Name + " - Zodiac Sign";
}

<section class="page-header">
    <div class="container">
        <h1>@Model.Name <span class="text-gold">@Html.Raw(Model.Icon)</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Zodiac")">Zodiac</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="text-center">
                    <span style="font-size:5rem;">@Html.Raw(Model.Icon)</span>
                    <h3>@Model.Name</h3>
                    <p class="text-muted">@Model.HindiName</p>
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" />
                </div>
            </div>
            <div class="col-lg-8">
                <h4>Description</h4>
                <p>@Model.Description</p>
                <div class="row mt-4">
                    <div class="col-sm-6">
                        <ul class="list-unstyled">
                            <li><strong>Element:</strong> @Model.Element</li>
                            <li><strong>Planet:</strong> @Model.Planet</li>
                            <li><strong>Lucky Number:</strong> @Model.LuckyNumber</li>
                            <li><strong>Lucky Color:</strong> @Model.LuckyColor</li>
                            <li><strong>Lucky Day:</strong> @Model.LuckyDay</li>
                        </ul>
                    </div>
                    <div class="col-sm-6">
                        <ul class="list-unstyled">
                            <li><strong>Strength:</strong> @Model.Strength</li>
                            <li><strong>Weakness:</strong> @Model.Weakness</li>
                            <li><strong>Career:</strong> @Model.Career</li>
                            <li><strong>Love:</strong> @Model.Love</li>
                            <li><strong>Health:</strong> @Model.Health</li>
                            <li><strong>Finance:</strong> @Model.Finance</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>