@model NirmalaAstrology_Web.ViewModels.RegisterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Create Account";
}
<section class="py-5" style="margin-top:80px;">
    <div class="container" style="max-width:560px;">
        <div class="glass-card p-4">
            <h1 class="h3 text-gold mb-2">Create Account</h1>
            <p class="text-light-muted small mb-4">Register to book appointments and manage your profile.</p>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                <div class="mb-3">
                    <label class="form-label text-light">Full name</label>
                    @Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control glass-input" })
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control glass-input", type = "email" })
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Mobile</label>
                    @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control glass-input" })
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Username</label>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control glass-input", autocomplete = "username" })
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Password</label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control glass-input", autocomplete = "new-password" })
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Confirm password</label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control glass-input", autocomplete = "new-password" })
                </div>
                <button type="submit" class="btn btn-gold w-100">Create account</button>
            }
            <p class="small text-light-muted mt-3 mb-0">Already registered? <a href="@Url.Action("Login", "Auth")">Sign in</a></p>
        </div>
    </div>
</section>
