@model NirmalaAstrology_Web.ViewModels.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Forgot Password";
}
<section class="py-5" style="margin-top:80px;">
    <div class="container" style="max-width:480px;">
        <div class="glass-card p-4">
            <h1 class="h4 text-gold">Forgot Password</h1>
            <p class="small text-light-muted">Enter your account email. If it exists, a temporary password will be emailed.</p>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                <div class="mb-3"><label class="form-label text-light">Email</label>@Html.TextBoxFor(m => m.Email, new { @class = "form-control glass-input", type = "email" })</div>
                <button type="submit" class="btn btn-gold w-100">Send reset</button>
            }
        </div>
    </div>
</section>
