@model NirmalaAstrology_Web.ViewModels.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Change Password";
}
<section class="py-5" style="margin-top:80px;">
    <div class="container" style="max-width:480px;">
        <div class="glass-card p-4">
            <h1 class="h4 text-gold">Change Password</h1>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                <div class="mb-3"><label class="form-label text-light">Current password</label>@Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control glass-input" })</div>
                <div class="mb-3"><label class="form-label text-light">New password</label>@Html.PasswordFor(m => m.NewPassword, new { @class = "form-control glass-input" })</div>
                <div class="mb-3"><label class="form-label text-light">Confirm</label>@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control glass-input" })</div>
                <button type="submit" class="btn btn-gold w-100">Update password</button>
            }
        </div>
    </div>
</section>
