@model NirmalaAstrology_Web.ViewModels.VivahMuhurtaViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = "Vivah Muhurta";
}

<div class="page-header">
    <h1>Vivah Muhurta</h1>
    <p>MVP from VB6 <code>m1Marriage_Muhurata</code>: Jantri Saahe date-range lookup of lagna windows and puja remarks (<code>VivahMuhurtaPuja</code>). Seed data covers 16.04.2016 – 12.03.2018.</p>
</div>

@using (Html.BeginForm("Index", "VivahMuhurta", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
    <div class="glass-card p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-light">From</label>
                @Html.TextBoxFor(m => m.FromDate, "{0:yyyy-MM-dd}", new { @class = "form-control glass-input", type = "date" })
            </div>
            <div class="col-md-3">
                <label class="form-label text-light">To</label>
                @Html.TextBoxFor(m => m.ToDate, "{0:yyyy-MM-dd}", new { @class = "form-control glass-input", type = "date" })
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-gold">Search Saahe</button>
            </div>
        </div>
    </div>
}

@if (Model.Result != null)
{
    var r = Model.Result;
    <section class="glass-card p-4 mt-4">
        <h2 class="h5 text-gold">@r.From.ToString("dd.MM.yyyy") – @r.To.ToString("dd.MM.yyyy") · @r.Days.Count day(s)</h2>
        <p class="text-light-muted small">@r.CoverageNote</p>

        @if (r.Days.Count == 0)
        {
            <p class="mb-0">No Vivah muhurta rows in this range (data seed ends 2018).</p>
        }
        else
        {
            foreach (var day in r.Days)
            {
                <div class="mb-4">
                    <h3 class="h6 text-gold mb-2">@day.DateLabel · @day.Weekday</h3>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm app-table">
                            <thead><tr><th>Lagna</th><th>Remarks / puja</th></tr></thead>
                            <tbody>
                            @foreach (var s in day.Slots)
                            {
                                <tr>
                                    <td>@s.LagnaName</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Remark) ? "—" : s.Remark)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </section>
}
