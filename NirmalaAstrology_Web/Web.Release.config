<?xml version="1.0"?>
<!-- Release / hosting transforms for BigRock .NET Framework MVC -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- Show real errors until site is stable; switch back to RemoteOnly later -->
    <customErrors mode="Off" defaultRedirect="~/Error" xdt:Transform="Replace">
      <error statusCode="404" redirect="~/Error/NotFound" />
      <error statusCode="500" redirect="~/Error" />
    </customErrors>
  </system.web>
  <!-- Remove Roslyn CodeDom — not needed for Framework MVC on shared hosting -->
  <system.codedom xdt:Transform="Remove" />
</configuration>
