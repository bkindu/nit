@model NirmalaAstrology_Web.Models.AppointmentRecord
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = "Appointment " + Model.BookingRef;
    var pay = ViewBag.Payment as NirmalaAstrology_Web.Models.PaymentRecord;
}
<div class="page-header">
    <h1>@Model.BookingRef</h1>
    <p>@Model.CustomerName · @Model.CustomerEmail · @Model.CustomerMobile</p>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="glass-card p-4">
            <table class="table table-dark table-sm">
                <tr><th>Service</th><td>@Model.ServiceName</td></tr>
                <tr><th>When</th><td>@Model.AppointmentDate.ToString("dd/MM/yyyy") · @NirmalaAstrology_Web.Services.AppointmentService.FormatTime(Model.AppointmentTime)</td></tr>
                <tr><th>Amount</th><td>₹@Model.Amount.ToString("0.00")</td></tr>
                <tr><th>Payment</th><td>@Model.PaymentStatus</td></tr>
                <tr><th>Status</th><td>@Model.AppointmentStatus</td></tr>
                <tr><th>Notes</th><td>@(Model.Notes ?? "—")</td></tr>
                <tr><th>Admin notes</th><td>@(Model.AdminNotes ?? "—")</td></tr>
                <tr><th>Approved</th><td>@(Model.ApprovedAt.HasValue ? Model.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td></tr>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="glass-card p-4 mb-3">
            <h2 class="h6 text-gold">Payment</h2>
            @if (pay != null)
            {
                <p class="small mb-1">Order: @pay.OrderId</p>
                <p class="small mb-1">Txn: @(pay.TransactionRef ?? "—")</p>
                <p class="small mb-3">Gateway: @pay.Gateway · @pay.PaymentStatus</p>
                using (Html.BeginForm("VerifyPayment", "Appointments", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.AppointmentId" />
                    <button class="btn btn-sm btn-gold" name="markPaid" value="true">Mark Paid (verified)</button>
                    <button class="btn btn-sm btn-outline-gold" name="markPaid" value="false">Reject payment</button>
                }
            }
        </div>
        <div class="glass-card p-4">
            <h2 class="h6 text-gold">Update status</h2>
            @using (Html.BeginForm("SetStatus", "Appointments", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AppointmentId" />
                <div class="mb-2">
                    <select name="status" class="form-select glass-input">
                        <option value="Approved">Approve</option>
                        <option value="Rejected">Reject</option>
                        <option value="Cancelled">Cancel</option>
                        <option value="Completed">Complete</option>
                        <option value="PendingApproval">Pending Approval</option>
                    </select>
                </div>
                <div class="mb-2"><textarea name="adminNotes" class="form-control glass-input" rows="3" placeholder="Admin notes"></textarea></div>
                <button type="submit" class="btn btn-gold">Save status</button>
            }
        </div>
    </div>
</div>
<p class="mt-3"><a href="@Url.Action("Index")">← Back to list</a></p>
