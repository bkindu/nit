@model System.Collections.Generic.IList<NirmalaAstrology_Web.Models.AppointmentRecord>
@using System
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.Title = "Appointments";
    var page = (int)(ViewBag.Page ?? 1);
    var total = (int)(ViewBag.Total ?? 0);
    var pageSize = (int)(ViewBag.PageSize ?? 25);
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
}
<div class="page-header">
    <h1>Appointments</h1>
    <p>Manage bookings, verify payments, approve or reject.</p>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="status" class="form-select glass-input">
            <option value="">All statuses</option>
            @foreach (var s in new[] { "PendingPayment", "PendingApproval", "Approved", "Completed", "Cancelled", "Rejected" })
            {
                <option value="@s" @(string.Equals(ViewBag.Status as string, s, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@s</option>
            }
        </select>
    </div>
    <div class="col-md-5"><input type="text" name="q" value="@ViewBag.Query" class="form-control glass-input" placeholder="Search ref / name / email / mobile" /></div>
    <div class="col-md-2"><button class="btn btn-gold w-100" type="submit">Search</button></div>
</form>
<div class="table-responsive glass-card p-2">
    <table class="table table-dark table-sm app-table mb-0">
        <thead>
            <tr>
                <th>Booking</th><th>Customer</th><th>Service</th><th>When</th><th>Amount</th><th>Payment</th><th>Status</th><th>Created</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.BookingRef</td>
                <td>@a.CustomerName<br /><span class="small">@a.CustomerEmail</span></td>
                <td>@a.ServiceName</td>
                <td>@a.AppointmentDate.ToString("dd/MM/yyyy")<br />@NirmalaAstrology_Web.Services.AppointmentService.FormatTime(a.AppointmentTime)</td>
                <td>₹@a.Amount.ToString("0.00")</td>
                <td>@a.PaymentStatus</td>
                <td>@a.AppointmentStatus</td>
                <td>@a.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td><a href="@Url.Action("Details", new { id = a.AppointmentId })">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="mt-3 small text-light-muted">Page @page of @pages · @total total</div>
@if (page > 1)
{
    <a href="@Url.Action("Index", new { status = ViewBag.Status, q = ViewBag.Query, page = page - 1 })">Prev</a>
}
@if (page < pages)
{
    <a href="@Url.Action("Index", new { status = ViewBag.Status, q = ViewBag.Query, page = page + 1 })">Next</a>
}
